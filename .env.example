# M0-T06A — local development environment.
# Copy to .env.local. Never commit real secrets (SEED_README.md:7).

# Matches compose.yaml. Host port 55432 avoids clashing with other local
# PostgreSQL containers on the default port.
DATABASE_URL=postgresql://hubnetwork:hubnetwork_local_dev@localhost:55432/hubnetwork_p0

# Exposes the dev-only harness routes (/dev/typography, /dev/primitives).
# Never set in production.
ENABLE_DEV_ROUTES=1

# WF01-S06 — private avatar storage (DEC-WF01-S06-D3). Provisional technical
# configuration, not business policy. The directory must not be web-served;
# bytes are served only by /media/assets/:id after a session check.
MEDIA_STORAGE_DIR=.data/media
MEDIA_AVATAR_MAX_BYTES=2097152

# WF01-S07 — legal document TEXT behind content_url (DEC-WF01-S07-D1/D8).
# Release content: <TYPE>.<version>.md per legal_documents row. Unset on a dev
# server (ENABLE_DEV_ROUTES) = the marked non-production fixtures in
# content/legal-fixtures. Unset in production = 404: release blocker
# PRODUCTION_LEGAL_CONTENT_REQUIRED until real Terms/Privacy text is supplied.
# LEGAL_CONTENT_DIR=

# TASK 22-PREVIEW-AUTH — magic-link e-mail (server-only; never NEXT_PUBLIC_*).
# Secret: set only in the server env file, never in git.
RESEND_API_KEY=
EMAIL_FROM="1Hub Network <no-reply@1hubnetwork.io.vn>"
APP_PUBLIC_BASE_URL=https://1hubnetwork.io.vn

# TASK 22-PREVIEW-LIBRARY-FIX — public startup directory read by /library (DEC-L15-D7).
# Optional; defaults to https://startup.1hub.cloud/data/startup.json.
# LIBRARY_STARTUP_SOURCE_URL=
